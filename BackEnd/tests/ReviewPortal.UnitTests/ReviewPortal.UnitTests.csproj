<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\ReviewPortal.API\Controllers\AuthController.cs" Link="Controllers\AuthController.cs" />
    <Compile Include="..\..\src\ReviewPortal.API\Controllers\CategoriesController.cs" Link="Controllers\CategoriesController.cs" />
    <Compile Include="..\..\src\ReviewPortal.API\Controllers\ReviewCommentsController.cs" Link="Controllers\ReviewCommentsController.cs" />
    <Compile Include="..\..\src\ReviewPortal.API\Controllers\ToolReviewsController.cs" Link="Controllers\ToolReviewsController.cs" />
    <Compile Include="..\..\src\ReviewPortal.API\Controllers\ToolsController.cs" Link="Controllers\ToolsController.cs" />
    <Compile Include="..\..\src\ReviewPortal.API\Extensions\ControllerBaseExtensions.cs" Link="Extensions\ControllerBaseExtensions.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseBinaryProjectReferences)' != 'true'">
    <ProjectReference Include="..\..\src\ReviewPortal.Domain\ReviewPortal.Domain.csproj" />
    <ProjectReference Include="..\..\src\ReviewPortal.Application\ReviewPortal.Application.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseBinaryProjectReferences)' == 'true'">
    <Reference Include="ReviewPortal.Domain">
      <HintPath>..\..\src\ReviewPortal.Domain\bin\$(Configuration)\net8.0\ReviewPortal.Domain.dll</HintPath>
    </Reference>
    <Reference Include="ReviewPortal.Application">
      <HintPath>..\..\src\ReviewPortal.Application\bin\$(Configuration)\net8.0\ReviewPortal.Application.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
